# Copy to `.env` next to docker-compose.prod.yml before first deploy:
#   cp .env.prod.example .env

# --- Postgres ---
POSTGRES_USER=ecolife
POSTGRES_PASSWORD=change-me-strong-db-password
POSTGRES_DB=ecolife

# --- Ports on host ---
HTTP_PORT=80
HTTPS_PORT=443

# --- Public URLs (CORS + links) ---
# Public marketing site (Netlify)
PUBLIC_SITE_URL=https://your-site.netlify.app
# Admin panel as served by this stack
ADMIN_PANEL_URL=https://your.domain.tld/admin
# Public API base (no trailing slash) — same host behind nginx is fine
PUBLIC_API_URL=https://your.domain.tld

# --- Auth ---
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars!!
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars!
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
ADMIN_EMAIL=admin@ecolife.local
ADMIN_PASSWORD=ChangeMeAdmin123!

# --- Booking ---
HOLD_MINUTES=30
REQUEST_HOLD_HOURS=6
APP_TIME_ZONE=Asia/Tashkent
CHECK_IN_TIME=14:00
CHECK_OUT_TIME=12:00
# Minutes released beds stay unavailable after each check-out (cleaning).
CLEANING_BUFFER_MINUTES=60
MEAL_BREAKFAST_TIME=08:00
MEAL_LUNCH_TIME=13:00
MEAL_DINNER_TIME=19:00
MIN_STAY_NIGHTS=1
MAX_STAY_NIGHTS=30

# --- Payments (prod: drop mock) ---
# Keep false until Payme/Click credentials are live; then set true.
PAYMENTS_ENABLED=false
PAYMENT_PROVIDERS=payme,click
PAYME_MERCHANT_ID=
PAYME_KEY=
PAYME_LOGIN=Paycom
PAYME_CHECKOUT_URL=https://checkout.paycom.uz
CLICK_MERCHANT_ID=
CLICK_SERVICE_ID=
CLICK_SECRET_KEY=

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_IDS=
DIGEST_HOUR=8

# --- Backup ---
BACKUP_KEEP_DAYS=7
BACKUP_INTERVAL_SECONDS=86400
TZ=Asia/Tashkent

LOG_LEVEL=info
