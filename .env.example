# Public site (Vite / Netlify). Leave empty in local dev to use the Vite proxy → Nest :3000.
#
# Production (Netlify): set this to the public origin of the API behind nginx, e.g.
#   VITE_API_URL=https://your.domain.tld
# Do not include a trailing slash. The site calls `${VITE_API_URL}/api/v1/...`.
VITE_API_URL=

# Comma-separated payment providers shown in the booking modal.
# Dev default (when unset): mock,payme,click
# Prod example: payme,click
# VITE_PAYMENT_PROVIDERS=payme,click
