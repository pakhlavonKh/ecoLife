# Public site (Vite / Netlify). Leave empty in local dev to use the Vite proxy → Nest :3000.
#
# Production (Netlify) — preferred: call the VPS API directly (bypasses Netlify proxy):
#   VITE_API_URL=https://api.eco-life-etiqod.com
# Leave empty to use netlify.toml /api/* proxy instead. Do not include a trailing slash.
VITE_API_URL=

# Mirror API PAYMENTS_ENABLED. false (default): booking modal is a pre-request
# (no Payme/Click UI). true: show providers + redirect to paymentUrl.
# VITE_PAYMENTS_ENABLED=false

# Comma-separated payment providers shown in the booking modal (when payments on).
# Dev default (when unset): mock,payme,click
# Prod example: payme,click
# VITE_PAYMENT_PROVIDERS=payme,click
