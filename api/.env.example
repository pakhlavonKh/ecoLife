# --- Database ---
DATABASE_URL=postgresql://ecolife:ecolife@localhost:5432/ecolife?schema=public

# --- App ---
PORT=3000
NODE_ENV=development
# CORS whitelist (required in production — never leave empty when NODE_ENV=production)
PUBLIC_SITE_URL=http://localhost:5173
ADMIN_PANEL_URL=http://localhost:5174
# Base URL of this API (used for mock checkout redirects / absolute links)
PUBLIC_API_URL=http://localhost:3000

# --- Auth (Phase 2+) ---
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars!!
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars!
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
LOG_LEVEL=info

# --- Seed admin ---
ADMIN_EMAIL=admin@ecolife.local
ADMIN_PASSWORD=ChangeMeAdmin123!

# --- Booking rules (confirmed Phase 1) ---
HOLD_MINUTES=30
# Hold duration for online_request (PAYMENTS_ENABLED=false) — operator contact window
REQUEST_HOLD_HOURS=6
# Resort timezone: all wall-clock check-in/out times are interpreted here.
APP_TIME_ZONE=Asia/Tashkent
# Default local check-in / check-out times when the guest or admin does not pick one.
CHECK_IN_TIME=14:00
CHECK_OUT_TIME=12:00
# Minutes the released beds stay unavailable after every check-out (cleaning).
# Not stored in the DB — changing it re-prices future availability immediately.
CLEANING_BUFFER_MINUTES=60
MIN_STAY_NIGHTS=1
MAX_STAY_NIGHTS=30

# --- Payments (Phase 4+) ---
# false (default): public POST /bookings creates a pre-request (source=online_request)
# without paymentUrl; operator confirms manually. true: classic Payme/Click/Mock flow.
PAYMENTS_ENABLED=false
PAYMENT_PROVIDERS=mock,payme,click
# Payme Merchant API (JSON-RPC). Auth: Basic Paycom:PAYME_KEY
PAYME_MERCHANT_ID=
PAYME_KEY=
PAYME_LOGIN=Paycom
PAYME_CHECKOUT_URL=https://checkout.paycom.uz
# Click SHOP-API
CLICK_MERCHANT_ID=
CLICK_SERVICE_ID=
CLICK_SECRET_KEY=

# --- Telegram (Phase 7+ / BOT_ROLES Phase A+) ---
# Empty TELEGRAM_BOT_TOKEN = bot disabled (API works as usual).
# Token from @BotFather.
TELEGRAM_BOT_TOKEN=
# Optional: bot username without @ (for invite deep links). Auto-filled from getMe when bot starts.
TELEGRAM_BOT_USERNAME=
# DEPRECATED fallback: used only when telegram_recipients table is empty.
# On seed / API start, these chat IDs are migrated as role=admin.
TELEGRAM_ADMIN_CHAT_IDS=
# all = outbound + polling (local default) | api = outbound only | worker = polling only
TELEGRAM_BOT_ROLE=all
# Morning digest hour in Asia/Tashkent (0–23). Cleaner digest: checkout rooms only.
DIGEST_HOUR=8
