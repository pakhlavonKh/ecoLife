generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum UserRole {
  admin
  manager

  @@map("user_role")
}

enum PaymentStatus {
  unpaid
  deposit_paid
  paid_full
  refunded

  @@map("payment_status")
}

enum BookingStatus {
  pending_payment
  deposit_paid
  confirmed
  checked_in
  checked_out
  cancelled

  @@map("booking_status")
}

enum BookingSource {
  online
  online_request
  manual

  @@map("booking_source")
}

enum PaymentProvider {
  payme
  click
  cash
  card
  transfer
  terminal
  mock

  @@map("payment_provider")
}

enum PaymentRecordStatus {
  created
  pending
  succeeded
  failed
  refunded

  @@map("payment_record_status")
}

enum ActorType {
  admin
  system
  customer

  @@map("actor_type")
}

enum TelegramStaffRole {
  owner
  admin
  manager
  cleaner

  @@map("telegram_staff_role")
}

enum TelegramLanguage {
  ru
  uz

  @@map("telegram_language")
}

enum NotificationEvent {
  booking_created            @map("booking.created")
  payment_received           @map("payment.received")
  booking_checked_in         @map("booking.checked_in")
  booking_checked_out        @map("booking.checked_out")
  booking_updated            @map("booking.updated")
  booking_cancelled          @map("booking.cancelled")
  system_hold_expired        @map("system.hold_expired")
  system_late_payment_review @map("system.late_payment_review")
  system_payment_failed      @map("system.payment_failed")
  system_room_locked         @map("system.room_locked")
  digest_morning             @map("digest.morning")

  @@map("notification_event")
}

// ─── Models ──────────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String   @map("password_hash")
  name         String
  role         UserRole @default(admin)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  bookingsCreated  Booking[]         @relation("BookingCreatedBy")
  refreshTokens    RefreshToken[]
  telegramInvites  TelegramInvite[]
  roomLocksCreated RoomLock[]        @relation("RoomLockCreatedBy")

  @@map("users")
}

model RefreshToken {
  id                String    @id @default(uuid()) @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  tokenHash         String    @unique @map("token_hash")
  expiresAt         DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt         DateTime? @map("revoked_at") @db.Timestamptz(6)
  replacedByTokenId String?   @map("replaced_by_token_id") @db.Uuid
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model Customer {
  id        String   @id @default(uuid()) @db.Uuid
  firstName String   @map("first_name")
  lastName  String   @map("last_name")
  phone     String
  notes     String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  bookings Booking[]

  @@index([phone])
  @@map("customers")
}

model Cottage {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  rooms Room[]

  @@map("cottages")
}

model RoomCategory {
  id                   String   @id @default(uuid()) @db.Uuid
  code                 String   @unique
  name                 String
  description          String   @default("")
  depositPercent       Int      @map("deposit_percent")
  /// Price per bed (guest) per night, UZS. Category-only (not capacity).
  pricePerBedPerNight  Decimal  @map("price_per_bed_per_night") @db.Decimal(14, 2)
  images               String[] @default([])
  isActive             Boolean  @default(true) @map("is_active")
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  rooms Room[]

  @@map("room_categories")
}

model Room {
  id         String   @id @default(uuid()) @db.Uuid
  cottageId  String   @map("cottage_id") @db.Uuid
  number     String   @unique
  capacity   Int
  categoryId String   @map("category_id") @db.Uuid
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  cottage      Cottage       @relation(fields: [cottageId], references: [id], onDelete: Restrict)
  category     RoomCategory  @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  bookingRooms BookingRoom[]
  roomLocks    RoomLock[]

  @@map("rooms")
}

model Booking {
  id               String          @id @default(uuid()) @db.Uuid
  publicCode       String          @unique @map("public_code")
  customerId       String          @map("customer_id") @db.Uuid
  /// Absolute check-in instant; the guest's local time lives in APP_TIME_ZONE.
  checkIn          DateTime        @map("check_in") @db.Timestamptz(6)
  /// Absolute check-out instant. Stay is half-open [check_in, check_out).
  checkOut         DateTime        @map("check_out") @db.Timestamptz(6)
  bedsTotal        Int             @map("beds_total")
  priceOriginal    Decimal         @map("price_original") @db.Decimal(14, 2)
  totalAmount      Decimal         @map("total_amount") @db.Decimal(14, 2)
  depositAmount    Decimal         @map("deposit_amount") @db.Decimal(14, 2)
  paidAmount       Decimal         @default(0) @map("paid_amount") @db.Decimal(14, 2)
  remainingAmount  Decimal         @map("remaining_amount") @db.Decimal(14, 2)
  paymentStatus    PaymentStatus   @default(unpaid) @map("payment_status")
  status           BookingStatus   @default(pending_payment)
  source           BookingSource   @default(online)
  notes            String?
  expiresAt        DateTime?       @map("expires_at") @db.Timestamptz(6)
  createdById      String?         @map("created_by") @db.Uuid
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  customer     Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  createdBy    User?         @relation("BookingCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  bookingRooms BookingRoom[]
  payments     Payment[]
  roomLocks    RoomLock[]

  @@index([status])
  @@index([checkIn, checkOut])
  @@map("bookings")
}

model BookingRoom {
  id         String   @id @default(uuid()) @db.Uuid
  bookingId  String   @map("booking_id") @db.Uuid
  roomId     String   @map("room_id") @db.Uuid
  bedsBooked Int      @map("beds_booked")
  checkIn    DateTime @map("check_in") @db.Timestamptz(6)
  checkOut   DateTime @map("check_out") @db.Timestamptz(6)
  isActive   Boolean  @default(true) @map("is_active")
  /// Generated tstzrange [check_in, check_out) — the guest's stay, WITHOUT the cleaning
  /// buffer (the buffer is applied in availability logic, never persisted).
  /// Room-level exclusion dropped (bed mode); anti-overbooking is app-level + room_locks.
  stay       Unsupported("tstzrange")?

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  room    Room    @relation(fields: [roomId], references: [id], onDelete: Restrict)

  @@index([roomId, isActive])
  @@map("booking_rooms")
}

/// Whole-room lock for specific dates (no further bed bookings while locked).
model RoomLock {
  id        String   @id @default(uuid()) @db.Uuid
  roomId    String   @map("room_id") @db.Uuid
  /// Optional link to the booking that caused the lock (backfill / admin).
  bookingId String?  @map("booking_id") @db.Uuid
  checkIn   DateTime @map("check_in") @db.Timestamptz(6)
  checkOut  DateTime @map("check_out") @db.Timestamptz(6)
  reason    String?
  createdById String? @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  /// Generated tstzrange [check_in, check_out) — exclusion in SQL migration.
  stay      Unsupported("tstzrange")?

  room      Room     @relation(fields: [roomId], references: [id], onDelete: Restrict)
  booking   Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  createdBy User?    @relation("RoomLockCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([roomId, checkIn, checkOut])
  @@index([bookingId])
  @@map("room_locks")
}

model Payment {
  id            String              @id @default(uuid()) @db.Uuid
  bookingId     String              @map("booking_id") @db.Uuid
  provider      PaymentProvider
  providerTxnId String?             @map("provider_txn_id")
  amount        Decimal             @db.Decimal(14, 2)
  currency      String              @default("UZS")
  status        PaymentRecordStatus @default(created)
  payload       Json?               @db.JsonB
  createdAt     DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Restrict)

  @@unique([provider, providerTxnId])
  @@map("payments")
}

model AuditLog {
  id        String    @id @default(uuid()) @db.Uuid
  actorType ActorType @map("actor_type")
  actorId   String?   @map("actor_id")
  entity    String
  entityId  String    @map("entity_id")
  action    String
  diff      Json?     @db.JsonB
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([entity, entityId])
  @@index([createdAt])
  @@map("audit_log")
}

model TelegramRecipient {
  id         String            @id @default(uuid()) @db.Uuid
  chatId     BigInt            @unique @map("chat_id")
  name       String
  role       TelegramStaffRole
  language   TelegramLanguage  @default(uz)
  isActive   Boolean           @default(true) @map("is_active")
  mutedUntil DateTime?         @map("muted_until") @db.Timestamptz(6)
  createdAt  DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("telegram_recipients")
}

model TelegramInvite {
  id           String            @id @default(uuid()) @db.Uuid
  code         String            @unique @db.VarChar(8)
  role         TelegramStaffRole
  createdById  String            @map("created_by") @db.Uuid
  expiresAt    DateTime          @map("expires_at") @db.Timestamptz(6)
  usedAt       DateTime?         @map("used_at") @db.Timestamptz(6)
  usedByChatId BigInt?           @map("used_by_chat_id")
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  createdBy User @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@index([expiresAt])
  @@map("telegram_invites")
}

model NotificationRule {
  id      String            @id @default(uuid()) @db.Uuid
  event   NotificationEvent
  role    TelegramStaffRole
  enabled Boolean           @default(true)

  @@unique([event, role])
  @@map("notification_rules")
}
